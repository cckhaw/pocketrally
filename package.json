{
  "name": "pocket-rally",
  "version": "1.0.0",
  "private": true,
  "description": "Pocket Rally - a 3D toy RC arcade racer for the browser",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx scripts/dev-api.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "thumbnail": "node scripts/make-thumbnail.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
